        <!-- Requests Table -->
        <Panel headerText="Requests List" class="sapUiTinyMargin">
            <content>
                <Table
                    id="requestsTable"
                    items="{requestsModel>/requests}"
                    class="sapUiTinyMarginTop"
                    width="100%">
                    <columns>
                        <Column width="8%">
                            <Text text="Request ID"/>
                        </Column>
                        <Column width="8%">
                            <Text text="Material ID"/>
                        </Column>
                        <Column width="18%">
                            <Text text="Material Name"/>
                        </Column>
                        <Column width="22%">
                            <Text text="Description"/>
                        </Column>
                        <Column width="10%">
                            <Text text="Status"/>
                        </Column>
                        <Column width="12%">
                            <Text text="Created By"/>
                        </Column>
                        <Column width="12%">
                            <Text text="Created Date"/>
                        </Column>
                        <Column width="10%">
                            <Text text="Actions"/>
                        </Column>
                    </columns>
                                            <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{requestsModel>requestID}"/>
                                    <Text text="{requestsModel>materialsID}"/>
                                    <Text text="{requestsModel>materialName}"/>
                                    <Text text="{requestsModel>materialDescription}"/>
                                    <ObjectStatus
                                        text="{requestsModel>status}"
                                        state="{= ${requestsModel>status} === 'emailSentToIMA' ? 'Warning' : 'Error'}"/>
                                    <Text text="{requestsModel>createdBy}"/>
                                    <Text text="{requestsModel>createdAt}"/>
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <Button
                                            text="Send Email to IMA"
                                            type="Accept"
                                            press="onSendEmailToIMA"
                                            enabled="{= ${requestsModel>status} === 'requested'}"
                                            width="100%"
                                            class="sapUiTinyMarginBottom"/>
                                        <Button
                                            text="Close Request"
                                            type="Emphasized"
                                            press="onCloseRequest"
                                            enabled="{= ${requestsModel>status} === 'emailSentToIMA'}"
                                            width="100%"
                                            class="sapUiTinyMarginBottom"/>
                                        <Button
                                            text="View Details"
                                            type="Transparent"
                                            press="onViewRequestDetails"
                                            width="100%"/>
                                    </VBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                </Table>
            </content>
        </Panel>



        <!-- Request Details Dialog -->
        <Dialog
            id="requestDetailsDialog"
            title="Request Details"
            contentWidth="700px"
            contentHeight="600px">
            <content>
                <VBox class="sapUiMediumMargin">
                    <VBox class="sapUiTinyMarginBottom">
                        <Label text="Request ID" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailRequestId" text="{requestsModel>requestID}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Material ID" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailId" text="{requestsModel>materialsID}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Material Name" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailName" text="{requestsModel>materialName}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Description" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailDescription" text="{requestsModel>materialDescription}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Status" class="sapUiTinyMarginBottom"/>
                        <ObjectStatus id="requestDetailStatus" text="{requestsModel>status}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Created By" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailRequestedBy" text="{requestsModel>createdBy}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Created Date" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailRequestedDate" text="{requestsModel>createdAt}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Modified By" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailModifiedBy" text="{requestsModel>modifiedBy}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Modified Date" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailModifiedDate" text="{requestsModel>modifiedAt}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Vendor" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailVendor" text="{requestsModel>vendorName}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Plant" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailPlant" text="{requestsModel>plantName}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Requestor First Name" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailRequestorFirstName" text="{requestsModel>requestorDetails/firstName}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Requestor Last Name" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailRequestorLastName" text="{requestsModel>requestorDetails/lastName}" class="sapUiTinyMarginBottom"/>
                        
                        <Label text="Requestor Email" class="sapUiTinyMarginBottom"/>
                        <Text id="requestDetailRequestorEmail" text="{requestsModel>requestorDetails/emailAddress}" class="sapUiTinyMarginBottom"/>
                    </VBox>
                </VBox>
            </content>
            <buttons>
                <Button text="Close" press="onCloseRequestDetails"/>
            </buttons>
        </Dialog>

        <!-- Confirmation Dialog for Actions -->
        <Dialog
            id="actionConfirmDialog"
            title="Confirm Action"
            type="Message"
            contentWidth="400px">
            <content>
                <Text id="actionConfirmText" text=""/>
            </content>
            <buttons>
                <Button text="Cancel" press="onCancelAction"/>
                <Button text="Confirm" type="Emphasized" press="onConfirmAction"/>
            </buttons>
        </Dialog>
    </VBox>
</core:FragmentDefinition>
